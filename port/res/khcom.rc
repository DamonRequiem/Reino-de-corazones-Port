/* Windows resources: icon, version information and manifest. */
#include <winver.h>

1 ICON "rdc.ico"
201 RCDATA "menu_atlas.png" /* the Esc menu (pc_menu.c) */
1 24 "khcom.manifest" /* RT_MANIFEST, CREATEPROCESS_MANIFEST_RESOURCE_ID */

VS_VERSION_INFO VERSIONINFO
FILEVERSION 1, 0, 0, 0
PRODUCTVERSION 1, 0, 0, 0
FILEFLAGSMASK 0x3F
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "0C0A04B0" /* Spanish (Modern Sort), Unicode */
        BEGIN
            VALUE "FileDescription", "Reino de Corazones - motor del juego"
            VALUE "FileVersion", "1.0.0"
            VALUE "InternalName", "rdc-motor"
            VALUE "OriginalFilename", "rdc-motor.exe"
            VALUE "ProductName", "Reino de Corazones"
            VALUE "ProductVersion", "1.0.0"
            VALUE "Comments", "Port nativo no oficial de Kingdom Hearts: Chain of Memories. Necesita tu propia copia del juego."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0C0A, 1200
    END
END
